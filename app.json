{
  "expo": {
    "name": "AiGo",
    "slug": "aigo",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "aigo",
    "userInterfaceStyle": "automatic",
    "web": {
      "output": "single",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#4B5BEF"
        }
      ],
      "@rnmapbox/maps"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "icon": "./assets/brand/icon.png",
    "ios": {
      "bundleIdentifier": "co.theaigo.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ใช้ตำแหน่งเพื่อแสดงว่าคุณอยู่ตรงไหนบนแผนที่ทริป (Shows where you are on your trip map.)"
      }
    },
    "android": {
      "package": "co.theaigo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#4B5BEF"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    }
  }
}
