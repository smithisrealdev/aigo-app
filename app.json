{
  "expo": {
    "name": "AiGo",
    "slug": "aigo",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "aigo",
    "userInterfaceStyle": "automatic",
    "web": {
      "output": "single",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#4B5BEF"
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "icon": "./assets/brand/icon.png",
    "ios": {
      "bundleIdentifier": "co.theaigo.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "co.theaigo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#4B5BEF"
      }
    }
  }
}
